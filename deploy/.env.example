MYSQL_DATABASE=gift_chat
MYSQL_USER=gift_chat
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
REDIS_PASSWORD=change-this-redis-password

APP_AUTH_JWT_SECRET=replace-with-a-long-random-secret
APP_AUTH_STAFF_ACCESS_TOKEN_DAYS=30
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com
APP_UPLOAD_PUBLIC_BASE_URL=https://your-domain.com
APP_REALTIME_REDIS_ENABLED=true
APP_REALTIME_REDIS_CHANNEL=gift-chat:realtime
APP_LOGIN_RATE_LIMIT_REDIS_ENABLED=true
APP_WEB_PUSH_ENABLED=false
APP_WEB_PUSH_PUBLIC_KEY=
APP_WEB_PUSH_PRIVATE_KEY=
APP_WEB_PUSH_SUBJECT=mailto:support@your-domain.com
APP_WEB_PUSH_TTL_SECONDS=300
APP_VIDEO_VENDOR=trtc
APP_VIDEO_TRTC_SDK_APP_ID=replace-with-your-trtc-sdk-app-id
APP_VIDEO_TRTC_SECRET_KEY=replace-with-your-trtc-secret-key
APP_VIDEO_TRTC_USER_SIG_EXPIRE_SECONDS=604800
APP_TENCENT_CHAT_ENABLED=false
APP_TENCENT_CHAT_SDK_APP_ID=
APP_TENCENT_CHAT_SECRET_KEY=
APP_TENCENT_CHAT_ADMIN_IDENTIFIER=administrator
APP_TENCENT_CHAT_ADMIN_USER_SIG=

PUBLIC_HTTP_PORT=80
